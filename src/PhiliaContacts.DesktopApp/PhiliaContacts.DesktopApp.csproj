<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Philia Contacts</Product>
    <Description>Manage all your contacts centrally and cleanly. Import from, or export to, your Android or Apple contacts using the universal vCard (Virtual Contact File) format.</Description>
    <AssemblyName>PhiliaContacts</AssemblyName>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhiliaContacts.Business\PhiliaContacts.Business.csproj" />
    <ProjectReference Include="..\PhiliaContacts.Data\PhiliaContacts.Data.csproj" />
    <ProjectReference Include="..\PhiliaContacts.Integrations\PhiliaContacts.Integrations.csproj" />
    <ProjectReference Include="..\PhiliaContacts.Presentation.Desktop\PhiliaContacts.Presentation.Desktop.csproj" />
  </ItemGroup>
</Project>
