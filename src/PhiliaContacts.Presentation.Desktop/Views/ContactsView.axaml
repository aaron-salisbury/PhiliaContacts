<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PhiliaContacts.Presentation.Desktop.ViewModels"
			  xmlns:views="clr-namespace:PhiliaContacts.Presentation.Desktop.Views"
             xmlns:contacts="clr-namespace:PhiliaContacts.Business.Modules.Contacts;assembly=PhiliaContacts.Business"
             x:Class="PhiliaContacts.Presentation.Desktop.Views.ContactsView"
             x:DataType="vm:ContactsViewModel">

	<!-- ref: https://docs.avaloniaui.net/docs/data-binding/master-detail -->

	<Grid ColumnDefinitions="250,*">
		<!-- Master: list of items -->
		<Border Background="{DynamicResource SystemListLowColor}">
			<ListBox Grid.Column="0"
					 CornerRadius="12,0,0,0"
					 ItemsSource="{Binding VisibleContacts}"
					 SelectedItem="{Binding SelectedContact}">
				<ListBox.ItemTemplate>
					<DataTemplate x:DataType="contacts:Contact">
						<StackPanel Margin="2,5">
							<TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
							<TextBlock Text="{Binding Organization}" FontSize="11" />
						</StackPanel>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</Border>

		<!-- Detail: selected item properties -->
		<ContentControl Grid.Column="1" Content="{Binding}" Padding="12">
			<ContentControl.DataTemplates>
				<DataTemplate DataType="vm:ContactsViewModel">
					<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
						<StackPanel Spacing="12" Margin="0,0,12,12">
							<TextBlock Text="Contact details" FontSize="20" FontWeight="SemiBold" />
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Button Content="Save contact" Command="{Binding SaveCommand}" />
								<Button Content="Delete selected" Click="Delete_Click" />
								<CheckBox Content="Favorite" IsChecked="{Binding Detail.IsFavorite}" VerticalAlignment="Center" />
							</StackPanel>

							<views:ContactDetailView />

							<Separator />
							
							<TextBlock Text="Import and export" FontWeight="SemiBold" />
							<TextBlock Text="Copy old JSON files before importing. Choose one source at a time; original files are retained." TextWrapping="Wrap" />
							<WrapPanel Orientation="Horizontal">
								<Button Content="Import older data" Click="ImportOlder_Click" Margin="0,0,6,6" />
								<Button Content="Import vCard" Click="ImportVCard_Click" Margin="0,0,6,6" />
								<Button Content="Export JSON" Click="ExportJson_Click" Margin="0,0,6,6" />
								<Button Content="Export vCard" Click="ExportVCard_Click" Margin="0,0,6,6" />
							</WrapPanel>
							
							<StackPanel IsVisible="{Binding HasPreview}" Spacing="6">
								<TextBlock Text="{Binding PreviewTitle}" FontWeight="SemiBold" />
								<ItemsControl ItemsSource="{Binding Candidates}">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="vm:ImportCandidate">
											<StackPanel Orientation="Horizontal" Spacing="10">
												<CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Name}" />
												<TextBlock Text="{Binding Hint}" />
											</StackPanel>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
								<StackPanel Orientation="Horizontal" Spacing="8">
									<Button Content="Import selected" Command="{Binding ConfirmVCardImportCommand}" />
									<Button Content="Cancel" Command="{Binding CancelVCardImportCommand}" />
								</StackPanel>
							</StackPanel>
							
						</StackPanel>
					</ScrollViewer>
				</DataTemplate>
			</ContentControl.DataTemplates>
		</ContentControl>
		
	</Grid>

</UserControl>
