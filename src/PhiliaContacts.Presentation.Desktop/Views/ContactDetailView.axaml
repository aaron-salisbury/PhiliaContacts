<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="clr-namespace:PhiliaContacts.Presentation.Desktop.ViewModels"
			 xmlns:converters="clr-namespace:PhiliaContacts.Presentation.Desktop.Base.Converters"
			 x:Class="PhiliaContacts.Presentation.Desktop.Views.ContactDetailView"
			 x:DataType="vm:ContactDetailViewModel"
			 xmlns:i="using:Material.Icons.Avalonia">

	<UserControl.Resources>
		<converters:BooleanToMaterialIconKindConverter x:Key="BooleanToMaterialIconKindConverter" />
	</UserControl.Resources>

	<UserControl.Styles>
		<Style Selector="i|MaterialIcon.section-icon">
			<Setter Property="Width" Value="24"/>
			<Setter Property="Height" Value="24"/>
			<Setter Property="Opacity" Value="0.5"/>
		</Style>

		<Style Selector="Button#AddPhotoButton">
			<Setter Property="Opacity" Value="0"/>
		</Style>
		<Style Selector="Ellipse#AddPhotoButtonBackground">
			<Setter Property="Opacity" Value="0"/>
		</Style>
		<Style Selector="Grid#PhotoGrid:pointerover Button#AddPhotoButton">
			<Setter Property="Opacity" Value="1"/>
		</Style>
		<Style Selector="Grid#PhotoGrid:pointerover Ellipse#AddPhotoButtonBackground">
			<Setter Property="Opacity" Value="0.8"/>
		</Style>
	</UserControl.Styles>

	<StackPanel Spacing="12">

		<!-- Header -->
		<StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Margin="0,0,0,12">
			<!-- Photo -->
			<Grid Name="PhotoGrid">
				<Ellipse HorizontalAlignment="Center" VerticalAlignment="Center" Width="80" Height="80">
					<Ellipse.Fill>
						<ImageBrush Source="{Binding PhotoPreview}" Stretch="UniformToFill" />
					</Ellipse.Fill>
				</Ellipse>
				<Grid Name="AddPhotoOverlay">
					<Ellipse
						Name="AddPhotoButtonBackground"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Width="83"
						Height="83"
						Fill="{DynamicResource SystemRegionColor}" />
					<Button
						Name="AddPhotoButton"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Width="80"
						Height="80"
						CornerRadius="35"
						Foreground="White"
						Click="ChoosePhoto_Click">
						<i:MaterialIcon Kind="CameraOutline" Width="24" Height="24" />
					</Button>
				</Grid>
			</Grid>
			<!-- Display Name -->
			<StackPanel Orientation="Horizontal" Spacing="8" Margin="24,0,12,0">
				<TextBlock Text="{Binding GivenName}" VerticalAlignment="Center" MaxLines="1" TextTrimming="CharacterEllipsis" FontSize="30" MaxWidth="300" />
				<TextBlock Text="{Binding FamilyName}" VerticalAlignment="Center" MaxLines="1" TextTrimming="CharacterEllipsis" FontSize="30" MaxWidth="300" />
			</StackPanel>
			<!-- Favorite -->
			<Button Name="FavoriteButton" Command="{Binding FlipFavoriteCommand}" Classes="noBackground">
				<i:MaterialIcon Kind="{Binding IsFavorite, Converter={StaticResource BooleanToMaterialIconKindConverter}, ConverterParameter=Star|StarOutline}" Width="30" Height="30" />
			</Button>
		</StackPanel>

		<!-- Name -->
		<Grid ColumnDefinitions="Auto,*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
			<i:MaterialIcon Grid.Row="0" Grid.Column="0" Kind="AccountOutline" Classes="section-icon" />
			<TextBox Grid.Row="0" Grid.Column="1" Watermark="Given name" Text="{Binding GivenName}" AutomationProperties.Name="Given name" />
			<TextBox Grid.Row="0" Grid.Column="2" Watermark="Family name" Text="{Binding FamilyName}" AutomationProperties.Name="Family name" />
			<TextBox Grid.Row="1" Grid.Column="1" Watermark="Phonetic given name" Text="{Binding PhoneticGivenName}" />
			<TextBox Grid.Row="1" Grid.Column="2" Watermark="Phonetic family name" Text="{Binding PhoneticFamilyName}" />
			<TextBox Grid.Row="2" Grid.Column="1" Watermark="Middle name" Text="{Binding MiddleName}" />
			<TextBox Grid.Row="2" Grid.Column="2" Watermark="Nickname" Text="{Binding Nickname}" />
			<TextBox Grid.Row="3" Grid.Column="1" Watermark="Prefix" Text="{Binding Prefix}" />
			<TextBox Grid.Row="3" Grid.Column="2" Watermark="Suffix" Text="{Binding Suffix}" />
		</Grid>

		<!-- Work -->
		<Grid ColumnDefinitions="Auto,*,*" RowDefinitions="Auto" ColumnSpacing="10" RowSpacing="8">
			<i:MaterialIcon Grid.Row="0" Grid.Column="0" Kind="OfficeBuildingOutline" Classes="section-icon" />
			<TextBox Grid.Row="0" Grid.Column="1" Watermark="Organization" Text="{Binding Organization}" />
			<TextBox Grid.Row="0" Grid.Column="2" Watermark="Title" Text="{Binding Title}" />
		</Grid>

		<!-- Birthday -->
		<Grid ColumnDefinitions="Auto,*,*" RowDefinitions="Auto" ColumnSpacing="10" RowSpacing="8">
			<i:MaterialIcon Grid.Row="0" Grid.Column="0" Kind="CakeVariantOutline" Classes="section-icon" />
			<TextBox Grid.Row="0" Grid.Column="1" Watermark="Birthday (YYYY-MM-DD or original date/time)" Text="{Binding Birthday}" />
		</Grid>

		<!-- Phone Numbers -->
		<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
			<i:MaterialIcon Grid.Row="0" Grid.Column="0" Kind="Cellphone" Classes="section-icon" />
			<TextBlock Grid.Row="0" Grid.Column="1" Text="Phone Numbers" FontWeight="SemiBold" />
			<StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
				<Button Content="Add phone number" Command="{Binding AddPhoneCommand}" />
				<Button Content="Remove selected phone" Command="{Binding RemovePhoneCommand}" />
			</StackPanel>
			<ListBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding PhoneNumbers}" SelectedItem="{Binding SelectedPhone}" MaxHeight="175">
				<ListBox.ItemTemplate>
					<DataTemplate x:DataType="vm:EditableValue">
						<StackPanel Orientation="Horizontal" Spacing="8" Margin="2">
							<TextBox Width="115" Watermark="Type (Home, Cell…)" Text="{Binding Type}" />
							<TextBox Width="290" Watermark="Phone number" Text="{Binding Value}" />
						</StackPanel>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</Grid>

		<!-- Email Addresses -->
		<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
			<i:MaterialIcon Grid.Row="0" Grid.Column="0" Kind="EmailOutline" Classes="section-icon" />
			<TextBlock Grid.Row="0" Grid.Column="1" Text="Email Addresses" FontWeight="SemiBold" />
			<StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
				<Button Content="Add email address" Command="{Binding AddEmailCommand}" />
				<Button Content="Remove selected email" Command="{Binding RemoveEmailCommand}" />
			</StackPanel>
			<ListBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding EmailAddresses}" SelectedItem="{Binding SelectedEmail}" MaxHeight="175">
				<ListBox.ItemTemplate>
					<DataTemplate x:DataType="vm:EditableValue">
						<StackPanel Orientation="Horizontal" Spacing="8" Margin="2">
							<TextBox Width="115" Watermark="Type" Text="{Binding Type}" />
							<TextBox Width="290" Watermark="Email" Text="{Binding Value}" />
						</StackPanel>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</Grid>

		<!-- Addresses -->
		<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
			<i:MaterialIcon Grid.Row="0" Grid.Column="0" Kind="HomeCityOutline" Classes="section-icon" />
			<TextBlock Grid.Row="0" Grid.Column="1" Text="Addresses" FontWeight="SemiBold" />
			<StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
				<Button Content="Add address" Command="{Binding AddAddressCommand}" />
				<Button Content="Remove selected address" Command="{Binding RemoveAddressCommand}" />
			</StackPanel>
			<ListBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Addresses}" SelectedItem="{Binding SelectedAddress}" MaxHeight="260">
				<ListBox.ItemTemplate>
					<DataTemplate x:DataType="vm:EditableAddress">
						<StackPanel Spacing="4" Margin="2,5">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<TextBox Width="100" Watermark="Type" Text="{Binding Type}" />
								<TextBox Width="300" Watermark="Street" Text="{Binding Street}" />
							</StackPanel>
							<StackPanel Orientation="Horizontal" Spacing="6">
								<TextBox Width="120" Watermark="City" Text="{Binding City}" />
								<TextBox Width="85" Watermark="State/region" Text="{Binding Region}" />
								<TextBox Width="90" Watermark="Postal code" Text="{Binding PostalCode}" />
								<TextBox Width="90" Watermark="Country" Text="{Binding Country}" />
							</StackPanel>
						</StackPanel>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</Grid>

		<!-- URL -->
		<Grid ColumnDefinitions="Auto,*,*" RowDefinitions="Auto" ColumnSpacing="10" RowSpacing="8">
			<i:MaterialIcon Grid.Row="0" Grid.Column="0" Kind="Web" Classes="section-icon" />
			<TextBox Grid.Row="0" Grid.Column="1" Watermark="Website" Text="{Binding Url}" />
		</Grid>

		<!-- Notes -->
		<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto" ColumnSpacing="10" RowSpacing="8">
			<i:MaterialIcon Grid.Row="0" Grid.Column="0" Kind="NoteMultipleOutline" Classes="section-icon" />
			<TextBox Grid.Row="0" Grid.Column="1" Watermark="Notes" Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="75" />
		</Grid>

		<!-- Socials -->
		<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto" ColumnSpacing="10" RowSpacing="8">
			<i:MaterialIcon Grid.Row="0" Grid.Column="0" Classes="section-icon" />
			<Expander Grid.Row="0" Grid.Column="1" Header="Social profiles">
				<StackPanel Spacing="5">
					<TextBox Watermark="X" Text="{Binding TwitterUser}" />
					<TextBox Watermark="Facebook" Text="{Binding FacebookUser}" />
					<TextBox Watermark="LinkedIn" Text="{Binding LinkedInUser}" />
				</StackPanel>
			</Expander>
		</Grid>

	</StackPanel>
</UserControl>
